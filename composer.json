{
    "name": "juanchosl/validators",
    "description": "Little methods collection in order to validate variables contents",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/JuanchoSL/Validators",
    "keywords": [
        "log",
        "debug",
        "validation",
        "validator",
        "validate",
        "iterables",
        "numbers",
        "string"
    ],
    "authors": [
        {
            "name": "Juan Sánchez Lecegui",
            "email": "Juan.Sanchez@tecnicosweb.com",
            "homepage": "https://www.linkedin.com/in/juansanchezlecegui/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "psr/log": "3.0.*",
        "juanchosl/datamanipulation": "1.0.*"
    },
    "require-dev": {
        "phpstan/phpstan": "1.12.*",
        "phpunit/phpunit": "10.5.*",
        "juanchosl/logger": "1.1.*"
    },
    "autoload": {
        "psr-4": {
            "JuanchoSL\\Validators\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JuanchoSL\\Validators\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "tests": "vendor/bin/phpunit --configuration phpunit.xml tests",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon"
    }
}